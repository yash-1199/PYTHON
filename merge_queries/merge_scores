Create PROCEDURE merge_scores
AS
BEGIN

MERGE scores AS target
USING (
    SELECT *
    FROM stg_scores
    WHERE last_modified > (
        SELECT ISNULL(last_load_time,'1900-01-01')
        FROM metadata_table
        WHERE table_name = 'scores'
    )
) AS source
ON target.student_id = source.student_id

WHEN MATCHED THEN
    UPDATE SET 
        target.score = source.score,
        target.last_modified = source.last_modified

WHEN NOT MATCHED THEN
    INSERT (student_id,course_id,score, last_modified)
    VALUES (source.student_id, source.course_id,source.score, source.last_modified);

-- Update watermark
UPDATE metadata_table
SET last_load_time = (
    SELECT MAX(last_modified) FROM scores
)
WHERE table_name = 'scores';

END;